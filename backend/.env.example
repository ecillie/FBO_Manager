# Copy to .env for local tooling. Do not commit real credentials.
FBO_ENVIRONMENT=local
FBO_DATABASE_NAME=fbo_manager
FBO_DATABASE_PORT=5432
FBO_DATABASE_URL=jdbc:postgresql://localhost:5432/fbo_manager
FBO_DATABASE_USERNAME=fbo_app
FBO_DATABASE_PASSWORD=replace-with-local-password
FBO_DATABASE_READINESS_TIMEOUT=3s
FBO_DATABASE_MAXIMUM_POOL_SIZE=10
FBO_DATABASE_MINIMUM_IDLE=2
FBO_DATABASE_CONNECTION_TIMEOUT=30000
FBO_MIGRATION_DATABASE_URL=jdbc:postgresql://localhost:5432/fbo_manager
FBO_MIGRATION_DATABASE_USERNAME=fbo_app
FBO_MIGRATION_DATABASE_PASSWORD=replace-with-local-password
FBO_APPLICATION_DATABASE_ROLE=fbo_app
FBO_MIGRATIONS_ENABLED=false
FBO_AIRPORT_TIMEZONE=America/New_York
FBO_LOG_LEVEL=INFO
FBO_ALLOWED_ORIGIN=http://localhost:5173
FBO_API_ADDRESS=127.0.0.1
FBO_API_PORT=8080
FBO_MANAGEMENT_ADDRESS=127.0.0.1
FBO_MANAGEMENT_PORT=8081
FBO_SHUTDOWN_TIMEOUT=30s
